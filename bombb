                    local pr = d.idx/#V.Wave.parts
                    local ang = t*vSpeed(2) + pr*math.pi*5
                    local r = vSize(1.8) + math.sin(ang*2)*0.5
                    local y = -3 + pr*6
                    d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(ang)*r, y, math.sin(ang)*r)
                    local col = getCol():Lerp(getCol2(), (math.sin(t*2+d.idx)+1)/2)
                    d.p.Color = col
                    if V.Wave.lights[d.idx] then V.Wave.lights[d.idx].Color = col end
                end
            end
        elseif V.Wave then for _, d in ipairs(V.Wave.parts) do pcall(function() d.p:Destroy() end) end V.Wave = nil end

