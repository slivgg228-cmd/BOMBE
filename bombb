            for _, d in ipairs(V.Helix.parts) do
                if d.p.Parent then
                    local pr = d.idx/#V.Helix.parts
                    local a = t*vSpeed(3) + pr*math.pi*8
                    local r = vSize(1.6)
                    local y = -3.5 + pr*7
                    d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r)
                    d.p.Color = getCol()
                end
            end
        elseif V.Helix then for _, d in ipairs(V.Helix.parts) do pcall(function() d.p:Destroy() end) end V.Helix = nil end

        if C.Tornado then
            if not V.Tornado then buildSimple("Tornado", c, vCount(36), true, false) end
            for _, d in ipairs(V.Tornado.parts) do
                if d.p.Parent then
                    local pr = d.idx/#V.Tornado.parts
                    local a = t*vSpeed(4) + pr*math.pi*6
                    local r = vSize(0.5 + pr*2.5)
                    local y = -4 + pr*8
                    d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r)
                    d.p.Color = getCol()
                end
            end
        elseif V.Tornado then for _, d in ipairs(V.Tornado.parts) do pcall(function() d.p:Destroy() end) end V.Tornado = nil end

        if C.Crystal then
            if not V.Crystal then
                local cr = {parts={}}
                for i = 1, vCount(8) do
                    local p = mkPart(c, Vector3.new(vSize(0.6),vSize(0.6),vSize(0.6)), Enum.PartType.Block, Enum.Material.Glass)
                    p.Color = getCol(); p.Transparency = vAlpha(0.3)
                    table.insert(cr.parts, {p=p, idx=i, phase=math.random()*math.pi*2})
                end
                V.Crystal = cr
            end
            for _, d in ipairs(V.Crystal.parts) do
                if d.p.Parent then
                    local a = t*vSpeed(0.9) + d.phase
                    local r = vSize(2.2)
                    local y = math.sin(a*1.5)*2.2
                    d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r) * CFrame.Angles(a, a*1.2, a*0.8)
                    d.p.Color = getCol():Lerp(getCol2(), (math.sin(t*2+d.idx)+1)/2)
                end
            end
        elseif V.Crystal then for _, d in ipairs(V.Crystal.parts) do pcall(function() d.p:Destroy() end) end V.Crystal = nil end

        -- остальные эффекты — единый шаблон
        local others = {
            {flag="Fire", count=vCount(12)},
            {flag="Storm", count=vCount(16)},
            {flag="Nebula", count=vCount(20)},
            {flag="Matrix", count=vCount(30)},
            {flag="Ring", count=vCount(20)},
            {flag="Halo", count=vCount(16)},
        }
        for _, o in ipairs(others) do
            if C[o.flag] then
                if not V[o.flag] then buildSimple(o.flag, c, o.count, true, o.flag=="Fire") end
                for _, d in ipairs(V[o.flag].parts) do
                    if d.p.Parent then
                        local pr = d.idx/#V[o.flag].parts
                        local a = t*vSpeed(2) + pr*math.pi*2
                        local r = vSize(2) + math.sin(a*1.5)*0.6
                        local y = math.sin(a*1.2 + t)*2.5
                        d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r)
                        local col = getCol():Lerp(getCol2(), (math.sin(t*3+d.idx)+1)/2)
                        d.p.Color = col
                        if V[o.flag].lights[d.idx] then V[o.flag].lights[d.idx].Color = col end
                    end
                end
            elseif V[o.flag] then
                for _, d in ipairs(V[o.flag].parts) do pcall(function() d.p:Destroy() end) end
                V[o.flag] = nil
            end
        end
    end)
end)

