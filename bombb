local V = {}
local vT = {t=0}
local function getCol() return CP[C.VColor].c end
local function getCol2()
    local b = getCol()
    return Color3.fromRGB(math.clamp(b.R*255*0.35,0,255), math.clamp(b.G*255*0.12,0,255), math.clamp(b.B*255*0.45,0,255))
end
local function vSize(v) return v * (C.VSize/100) end
local function vSpeed(v) return v * (C.VSpeed/100) end
local function vAlpha(v) return math.clamp(v * (C.VOpacity/100), 0, 1) end
local function vCount(v) return math.max(1, math.floor(v * (C.VCount/100))) end

local function mkPart(parent, size, shape, mat)
    local p = Instance.new("Part")
    p.Size = size; p.Shape = shape or Enum.PartType.Ball; p.Material = mat or Enum.Material.Neon
    p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Massless = true; p.CastShadow = false
    p.Parent = parent
    return p
end
local function mkEmitter(p, rate, life, speed, size, col1, col2)
    local e = Instance.new("ParticleEmitter", p)
    e.Texture = "rbxassetid://243660364"
    e.Rate = rate
    e.Lifetime = NumberRange.new(life, life*1.8)
    e.Speed = NumberRange.new(speed, speed*2)
    e.SpreadAngle = Vector2.new(180, 180)
    e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0)})
    e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, vAlpha(0.1)), NumberSequenceKeypoint.new(1, 1)})
    e.Color = ColorSequence.new(col1, col2)
    e.LightEmission = 1; e.LightInfluence = 0
    return e
end
local function mkLight(p, range, bright)
    local l = Instance.new("PointLight", p)
    l.Color = getCol(); l.Range = range; l.Brightness = bright
    return l
end
local function killAll()
    for _, list in pairs(V) do
        if type(list) == "table" then
            for _, o in pairs(list) do
                if typeof(o) == "Instance" then pcall(function() o:Destroy() end)
                elseif type(o) == "table" then for _, oo in pairs(o) do if typeof(oo) == "Instance" then pcall(function() oo:Destroy() end) end end end
            end
        elseif typeof(list) == "Instance" then pcall(function() list:Destroy() end) end
    end
    V = {}
end

-- упрощённые билдеры (20 эффектов)
local function buildSimple(name, c, count, lights, emitters)
    local t = {parts={}, lights={}, emitters={}}
    for i = 1, count do
        local p = mkPart(c, Vector3.new(vSize(0.25),vSize(0.25),vSize(0.25)))
        if emitters then table.insert(t.emitters, mkEmitter(p, 15, 0.5, 1, vSize(0.4), getCol(), getCol2())) end
        if lights then table.insert(t.lights, mkLight(p, vSize(4), 2)) end
        table.insert(t.parts, {p=p, idx=i, phase=math.random()*math.pi*2})
    end
    V[name] = t
end

RS.Heartbeat:Connect(function(dt)
    pcall(function()
        local c = P.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then
            if next(V) then killAll() end
