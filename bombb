local function doFling(target)
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyAngularVelocity") or v:IsA("BodyVelocity") then v:Destroy() end
        end
        local bav = Instance.new("BodyAngularVelocity", hrp)
        bav.AngularVelocity = Vector3.new(0, math.huge, 0)
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.P = math.huge
        local bv = Instance.new("BodyVelocity", hrp)
        bv.Velocity = Vector3.new(
            math.random(-C.FlingPower, C.FlingPower),
            C.FlingPower * 2,
            math.random(-C.FlingPower, C.FlingPower)
        )
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        task.delay(1.2, function()
            pcall(function() bav:Destroy() end)
            pcall(function() bv:Destroy() end)
        end)
    end)
end

local function flingRole(role)
    for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= P and plr.Character then
            if getRole(plr) == role then
                doFling(plr)
            end
        end
    end
end

