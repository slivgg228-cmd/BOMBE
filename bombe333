local bhopSpeed = 0
task.spawn(function()
    while task.wait(0.05) do
        pcall(function()
            if C.Bhop then
                local c = P.Character
                if c then
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h then
                        if h.MoveDirection.Magnitude > 0 then
                            if bhopSpeed < C.BhopStart then bhopSpeed = C.BhopStart end
                            if h:GetState() == Enum.HumanoidStateType.Landed then
                                h:ChangeState(Enum.HumanoidStateType.Jumping)
                                bhopSpeed = math.min(bhopSpeed + C.BhopBoost, C.BhopMax)
                            end
                            h.WalkSpeed = bhopSpeed
                        else
                            bhopSpeed = 0
                        end
                    end
                end
            else
                bhopSpeed = 0
            end
        end)
    end
end)

