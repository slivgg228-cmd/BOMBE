local waveParts = {}
local waveTime = 0
local WAVE_COUNT = 80

local function updateWave()
    local char = Player.Character
    if not char then 
        for _, w in pairs(waveParts) do w:Destroy() end
        waveParts = {}
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        for _, w in pairs(waveParts) do w:Destroy() end
        waveParts = {}
        return 
    end
    
    if Config.Wave then
        if #waveParts == 0 then
            for i = 1, WAVE_COUNT do
                local wavePart = Instance.new("Part")
                wavePart.Name = "BOMBE_Wave"
                wavePart.Size = Vector3.new(0.2, 0.2, 1.0)
                wavePart.Material = Enum.Material.Neon
                wavePart.Transparency = 0.4
                wavePart.CanCollide = false
                wavePart.Massless = true
                wavePart.Anchored = true
                wavePart.Parent = char
                table.insert(waveParts, wavePart)
            end
        end
        
        waveTime = waveTime + 0.07
        local total = #waveParts
        
        for i, wavePart in ipairs(waveParts) do
            local progress = i / total
            local bodyHeight = 5
            local yOffset = -2.5 + progress * bodyHeight
            local angle = waveTime + progress * math.pi * 6
            
            local r = 1.8 + math.sin(angle * 2 + waveTime * 3) * 0.4
            local x = math.cos(angle) * r
            local z = math.sin(angle) * r
            local yWave = math.sin(angle * 3 + waveTime * 2) * 0.3
            
            wavePart.CFrame = hrp.CFrame * CFrame.new(x, yOffset + yWave, z) * CFrame.Angles(
                math.sin(angle * 2) * 0.5,
                -angle,
                math.rad(90) + math.cos(angle) * 0.5
            )
            wavePart.Color = Config.WaveColor
            wavePart.Transparency = 0.3 + math.sin(waveTime * 3 + i * 0.15) * 0.15
        end
    else
        for _, w in pairs(waveParts) do w:Destroy() end
        waveParts = {}
    end
end

