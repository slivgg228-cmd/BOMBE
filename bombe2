local function createToggle(parent, yPos, labelText, configKey)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(15, 0, 30)
    frame.BorderColor3 = Color3.fromRGB(150, 40, 220)
    frame.BorderSizePixel = 1
    frame.Position = UDim2.new(0.05, 0, 0, yPos)
    frame.Size = UDim2.new(0.9, 0, 0, 26)
    frame.ZIndex = 2
    local c = Instance.new("UICorner")
    c.Parent = frame
    c.CornerRadius = UDim.new(0, 7)

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 5, 0, 0)
    label.Size = UDim2.new(0, 110, 1, 0)
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(200, 150, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.TextStrokeTransparency = 1
    label.ZIndex = 2

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.BackgroundColor3 = Color3.fromRGB(60, 0, 80)
    btn.BorderColor3 = Color3.fromRGB(180, 50, 255)
    btn.BorderSizePixel = 1
    btn.Position = UDim2.new(1, -48, 0, 2)
    btn.Size = UDim2.new(0, 42, 0, 22)
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.TextStrokeTransparency = 1
    btn.ZIndex = 2
    local bc = Instance.new("UICorner")
    bc.Parent = btn
    bc.CornerRadius = UDim.new(0, 7)

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        local targetColor = Config[configKey] and Color3.fromRGB(100, 0, 200) or Color3.fromRGB(60, 0, 80)
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
        btn.Text = Config[configKey] and "ON" or "OFF"
    end)
    return frame
end

