local groundWaves = {}
local groundWaveTime = 0

local function spawnGroundWave(position)
    local ring = Instance.new("Part")
    ring.Name = "BOMBE_GroundWave"
    ring.Shape = Enum.PartType.Cylinder
    ring.Size = Vector3.new(0.05, 0.5, 0.5)
    ring.Material = Enum.Material.Neon
    ring.Transparency = 0.3
    ring.CanCollide = false
    ring.Massless = true
    ring.Anchored = true
    ring.Parent = workspace
    ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    ring.Color = Config.GroundWaveColor
    
    local innerRing = Instance.new("Part")
    innerRing.Name = "BOMBE_InnerRing"
    innerRing.Shape = Enum.PartType.Cylinder
    innerRing.Size = Vector3.new(0.06, 0.3, 0.3)
    innerRing.Material = Enum.Material.Neon
    innerRing.Transparency = 0.1
    innerRing.CanCollide = false
    innerRing.Massless = true
    innerRing.Anchored = true
    innerRing.Parent = workspace
    innerRing.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    innerRing.Color = Config.GroundWaveColor:Lerp(Color3.new(1, 1, 1), 0.3)
    
    local light = Instance.new("PointLight")
    light.Brightness = 1.5
    light.Range = 6
    light.Color = Config.GroundWaveColor
    light.Parent = ring
    
    local particles = Instance.new("ParticleEmitter")
    particles.Texture = "rbxassetid://243660364"
    particles.Color = ColorSequence.new(Config.GroundWaveColor)
    particles.Size = NumberSequence.new(0.5)
    particles.Transparency = NumberSequence.new(0.5)
    particles.Lifetime = NumberRange.new(0.8)
    particles.Rate = 20
    particles.Speed = NumberRange.new(2)
    particles.SpreadAngle = Vector2.new(360, 360)
    particles.Parent = ring
    
    table.insert(groundWaves, {
        ring = ring,
        innerRing = innerRing,
        light = light,
        particles = particles,
        life = 1,
        startSize = 0.5,
        endSize = 6
    })
end

local function updateGroundWave()
    local char = Player.Character
    if not char then 
        for _, w in pairs(groundWaves) do 
            if w.ring then w.ring:Destroy() end
            if w.innerRing then w.innerRing:Destroy() end
        end
        groundWaves = {}
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        for _, w in pairs(groundWaves) do 
            if w.ring then w.ring:Destroy() end
            if w.innerRing then w.innerRing:Destroy() end
        end
        groundWaves = {}
        return 
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if Config.GroundWave then
        groundWaveTime = groundWaveTime + 0.1
        
        if humanoid.MoveDirection.Magnitude > 0.1 and groundWaveTime > 0.4 then
            groundWaveTime = 0
            local groundPos = hrp.Position - Vector3.new(0, 2.5, 0)
            spawnGroundWave(groundPos)
        end
        
        for i = #groundWaves, 1, -1 do
            local w = groundWaves[i]
            w.life = w.life - 0.025
            
            if w.life <= 0 then
                if w.ring then w.ring:Destroy() end
                if w.innerRing then w.innerRing:Destroy() end
                table.remove(groundWaves, i)
            else
                local progress = 1 - w.life
                local eased = 1 - (1 - progress) * (1 - progress)
                local currentSize = w.startSize + (w.endSize - w.startSize) * eased
                
                w.ring.Size = Vector3.new(0.05, currentSize, currentSize)
                w.ring.Transparency = 0.3 + progress * 0.7
                
                local innerSize = currentSize * 0.5
                w.innerRing.Size = Vector3.new(0.06, innerSize, innerSize)
                w.innerRing.Transparency = 0.1 + progress * 0.9
                
                if w.light then
                    w.light.Brightness = 1.5 * w.life
                    w.light.Range = 6 * w.life
                end
                
                if w.particles then
                    w.particles.Rate = 20 * w.life
                end
            end
        end
    else
        for _, w in pairs(groundWaves) do 
            if w.ring then w.ring:Destroy() end
            if w.innerRing then w.innerRing:Destroy() end
        end
        groundWaves = {}
    end
end

