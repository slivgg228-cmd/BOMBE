local halos = {}
local haloTime = 0

local function updateHalos()
    local char = Player.Character
    if not char then 
        for _, h in pairs(halos) do h:Destroy() end
        halos = {}
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        for _, h in pairs(halos) do h:Destroy() end
        halos = {}
        return 
    end
    
    if Config.Halo then
        if #halos ~= Config.HaloCount then
            for _, h in pairs(halos) do h:Destroy() end
            halos = {}
            for i = 1, Config.HaloCount do
                local halo = Instance.new("Part")
                halo.Name = "BOMBE_Halo_" .. i
                halo.Shape = Enum.PartType.Cylinder
                halo.Size = Vector3.new(0.08, 1.8, 1.8)
                halo.Material = Enum.Material.Neon
                halo.Transparency = 0.2
                halo.CanCollide = false
                halo.Massless = true
                halo.Anchored = true
                halo.Parent = char
                table.insert(halos, halo)
            end
        end
        
        haloTime = haloTime + 0.06
        local total = #halos
        
        for i, halo in ipairs(halos) do
            local progress = i / total
            local bodyHeight = 5
            local yOffset = -2.5 + progress * bodyHeight
            local angle = haloTime * 1.5 + progress * math.pi * 2
            
            local r = 0.8 + math.sin(angle * 2 + haloTime * 2) * 0.3
            local x = math.cos(angle) * r
            local z = math.sin(angle) * r
            local float = math.sin(haloTime * 2 + i * 0.5) * 0.15
            
            halo.CFrame = hrp.CFrame * CFrame.new(x, yOffset + float, z) * CFrame.Angles(
                math.sin(angle) * 0.4,
                -angle,
                math.rad(90) + math.cos(angle) * 0.4
            )
            halo.Color = Config.HaloColor
            halo.Transparency = 0.15 + math.sin(haloTime * 3 + i * 0.3) * 0.1
            
            if not halo:FindFirstChild("HaloLight") then
                local light = Instance.new("PointLight")
                light.Name = "HaloLight"
                light.Brightness = 0.5
                light.Range = 3
                light.Color = Config.HaloColor
                light.Parent = halo
            else
                halo.HaloLight.Color = Config.HaloColor
            end
        end
    else
        for _, h in pairs(halos) do h:Destroy() end
        halos = {}
    end
end

