                                if pPos.X > maxX then maxX = pPos.X end
                                if pPos.Y < minY then minY = pPos.Y end
                                if pPos.Y > maxY then maxY = pPos.Y end
                            end
                        end
                        if minX ~= math.huge then
                            local w = maxX - minX
                            local h = maxY - minY
                            local cx = (minX + maxX) / 2
                            local cy = (minY + maxY) / 2
