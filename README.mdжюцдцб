        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= Player and plr.Character then
                local th = plr.Character:FindFirstChild("HumanoidRootPart")
                if th then
                    local role = getPlayerRole(plr)
                    if (Config.FlingMurderer and role == "Murderer") or
                       (Config.FlingSheriff and role == "Sheriff") or
                       Config.FlingAll then
                        hrp.CFrame = CFrame.new(th.Position)
                        break
                    end
                end
            end
        end
    else
        if flingActive then
            flingActive = false
            if flingBV then flingBV:Destroy(); flingBV = nil end
            if flingBAV then flingBAV:Destroy(); flingBAV = nil end
            hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
            hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
            if Config.FlingReturn and flingOrigin then
                hrp.CFrame = flingOrigin
            end
            flingOrigin = nil
        end
    end
end)

