            ring.Color = Config.GroundWaveColor
            table.insert(groundWaves, {ring=ring, life=1, startSize=0.5, endSize=Config.GroundWaveSize})
        end
        for i = #groundWaves, 1, -1 do
            local w = groundWaves[i]
            w.life = w.life - 0.025
            if w.life <= 0 then
                w.ring:Destroy()
                table.remove(groundWaves, i)
            else
                local progress = 1 - w.life
                local eased = 1 - (1-progress)*(1-progress)
                local cs = w.startSize + (w.endSize - w.startSize) * eased
                w.ring.Size = Vector3.new(0.05, cs, cs)
                w.ring.Transparency = 0.3 + progress*0.7
            end
        end
    end
end)

