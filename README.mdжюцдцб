        else
            playToggleOff()
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60,0,80)}):Play()
        end
        btn.Text = Config[configKey] and "ON" or "OFF"
    end)
    return frame
