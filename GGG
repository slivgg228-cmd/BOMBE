local function getRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    local h = plr.Character:FindFirstChildOfClass("Humanoid")
    if h and h.Health <= 0 then return "Dead" end
    for _,t in pairs(plr.Character:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("knife") or n:find("ноже") then return "Murderer" end
            if n:find("gun") or n:find("pistol") then return "Sheriff" end
        end
    end
    return "Innocent"
end
local function rTag(r) return r=="Murderer" and "[MURD]" or r=="Sheriff" and "[SHERIFF]" or r=="Dead" and "[DEAD]" or "[INNO]" end
local function isG(n) n=n:lower() return n:find("gun") or n:find("pistol") or n:find("revolver") end
