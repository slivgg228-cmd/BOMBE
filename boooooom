                    local a = t*vSpeed(3) + pr*math.pi*2
                    local r = vSize(2.3) + math.sin(t+pr*3)*0.4
                    local y = math.sin(t*0.7+pr*2)*1.6
                    d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r)
                    local col = getCol():Lerp(getCol2(), (math.sin(t*2+d.idx*0.5)+1)/2)
                    d.p.Color = col; d.l.Color = col
                    d.l.Brightness = 1.5 + breath*1.5
                end
            end
        elseif V.Ring then for _, d in ipairs(V.Ring.parts) do pcall(function() d.p:Destroy() end) end V.Ring = nil end

        if C.Trail then
            if not V.Trail then buildTrail(c, hrp) end
            V.Trail.tr.Color = ColorSequence.new(getCol(), getCol2())
            V.Trail.tr2.Color = ColorSequence.new(getCol2(), getCol())
