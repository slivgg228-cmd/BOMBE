RS.Heartbeat:Connect(function(dt)
    pcall(function()
        local c = P.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then
            if next(V) then killAll() end
            return
        end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        vT.t = vT.t + dt
        local t = vT.t
        local breath = (math.sin(t*2)+1)/2

        if C.Wave then
            if not V.Wave then buildWave(c) end
            for i, p in ipairs(V.Wave.parts) do
                if p and p.Parent then
                    local pr = i/#V.Wave.parts
                    local ang = t*vSpeed(2) + pr*math.pi*5
                    local r = vSize(1.8) + math.sin(ang*2 + t*2)*0.5
                    local y = -3 + pr*6 + math.sin(ang*3 + t*3)*0.5
                    p.CFrame = hrp.CFrame * CFrame.new(math.cos(ang)*r, y, math.sin(ang)*r) * CFrame.Angles(math.sin(ang)*0.5, -ang, math.rad(90))
                    local col = getCol():Lerp(getCol2(), (math.sin(t*2+i*0.3)+1)/2)
                    p.Color = col
                    V.Wave.emitters[i].Color = ColorSequence.new(col, getCol2())
                    V.Wave.lights[i].Color = col
                    V.Wave.lights[i].Brightness = 1.5 + breath*1.5
                end
            end
        elseif V.Wave then
            for _, p in ipairs(V.Wave.parts) do pcall(function() p:Destroy() end) end V.Wave = nil
        end

        if C.Halo then
            if not V.Halo then buildHalo(c) end
            for i, d in ipairs(V.Halo.beams) do
                if d.a0.Parent and d.a1.Parent then
                    local y = 2.8 + d.k*0.25
                    local r = vSize(1.3) + math.sin(t*2+d.k)*0.2
                    local a = t*vSpeed(1.8) + d.k*math.pi*0.7
                    d.a0.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r)
                    d.a1.CFrame = hrp.CFrame * CFrame.new(math.cos(a+math.pi)*r, y, math.sin(a+math.pi)*r)
                    d.b.Color = ColorSequence.new(getCol(), getCol2(), getCol())
                    d.b.Width0 = vSize(1.2 + breath*0.4)
                    d.b.Width1 = vSize(1.2 + breath*0.4)
