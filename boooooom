    g1.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(200,80,255)),ColorSequenceKeypoint.new(0.5, Color3.fromRGB(10,0,20)),ColorSequenceKeypoint.new(1, Color3.fromRGB(200,80,255))})
