                if d.p.Parent then
                    local a = t*d.spd + d.phase
                    local r = vSize(2) + math.sin(a*2)*0.7
                    local y = math.sin(a*1.5)*2.6
                    d.p.CFrame = hrp.CFrame * CFrame.new(math.cos(a)*r, y, math.sin(a)*r)
